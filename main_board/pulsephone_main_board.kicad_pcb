				(color "#FF008000")
				(thickness 0.03048)
				(material "SM-001")
				(epsilon_r 3.8)
				(loss_tangent 0.03)
			)
			(layer "F.Cu"
				(type "copper")
				(thickness 0.035001)
			)
			(layer "dielectric 1"
				(type "prepreg")
				(thickness 0.210414)
				(material "NP-140F")
				(epsilon_r 4.4)
				(loss_tangent 0.02)
			)
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.015189)
			)
			(layer "dielectric 2"
				(type "prepreg")
				(thickness 1.064997)
				(material "FR4-Generic")
				(epsilon_r 4.6)
				(loss_tangent 0.02)
			)
			(layer "In2.Cu"
				(type "copper")
				(thickness 0.015189)
			)
			(layer "dielectric 3"
				(type "prepreg")
				(thickness 0.210414)
				(material "NP-140F")
				(epsilon_r 4.4)
				(loss_tangent 0.02)
			)
			(layer "B.Cu"
				(type "copper")
				(thickness 0.035001)
			)
			(layer "B.Mask"
				(type "Bottom Solder Mask")
				(color "#FF008000")
				(thickness 0.03048)
				(material "SM-001")
				(epsilon_r 3.8)
				(loss_tangent 0.03)
			)
			(layer "B.Paste"
				(type "Bottom Solder Paste")
			)
			(layer "B.SilkS"
				(type "Bottom Silk Screen")
			)
			(copper_finish "Lead-Free")
			(dielectric_constraints yes)
		)
		(pad_to_mask_clearance 0)
		(solder_mask_min_width 0.1)
		(allow_soldermask_bridges_in_footprints no)
